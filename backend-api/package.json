{
  "name": "hearthy-backend-api",
  "version": "1.0.0",
  "description": "Hearthy Health & Wellness Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node database/runMigrations.js up",
    "migrate:up": "node database/runMigrations.js up",
    "migrate:down": "node database/runMigrations.js down",
    "migrate:down:all": "node database/runMigrations.js down all",
    "migrate:fresh": "node database/runMigrations.js down all && node database/runMigrations.js up",
    "ai:setup": "pip install tensorflow scikit-learn numpy pandas joblib",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "health",
    "wellness",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "sweetalert2": "^11.26.24"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14"
  }
}
